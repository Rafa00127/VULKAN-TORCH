build/
build-*/
*.log
*.pyc
__pycache__/
.vs/
.vscode/
移植参考/

# python extension emitted into the package
vulkantorch/_vulkantorch*.pyd

# everything under data/ is test scratch (fixtures, converted models, dumps) —
# only data/ref_audio/ (the reference voice + BPE tokenizer) is tracked
data/*
!data/ref_audio/

# converted model weights (GGUF) — regenerate with tools/convert/convert_*.py
model/

# OCR scratch: reference tensors/text, transcripts (models live in model/)
data/ocr/

# scratch notebooks / tests, but keep the CMake build inputs + the benchmark
# suite (bench_cpp.cpp is compiled by CMakeLists; bench_py.py is its Python twin)
/bench/*
!/bench/bench_cpp.cpp
!/bench/bench_py.py
tests/*
!tests/test_matmul.cpp

# C# build output
bin/
obj/
