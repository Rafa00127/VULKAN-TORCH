build/
build-*/
*.log
*.pyc
__pycache__/
.vs/
.vscode/
/tool/*
!/tool/bench_ops.cpp
移植参考/
build_local.sh

CLAUDE.md
# local design notes / investigation logs (same treatment as CLAUDE.md, not shipped)
docs/

# python extension emitted into the package
vulkantorch/_vulkantorch*.pyd

# everything under data/ is test scratch (fixtures, converted models, dumps) —
# only data/ref_audio/ (the reference voice + BPE tokenizer) is tracked
data/*
!data/ref_audio/

# only the converters + the quantizer source ship; the dump/compare scripts
# under tools/ are dev-only
tools/*
!tools/convert/
!tools/quantize/

# converted model weights (GGUF) — regenerate with tools/convert/convert_*.py
# (exclude the contents, not the dir: git cannot re-include a file under an
#  excluded directory)
model/*
# ...except the IndexTTS tokenizer: needed at runtime and small (~900 KB),
# same treatment as data/ref_audio/higgs_tts_v3_tokenizer.json
!model/indextts2.5/
model/indextts2.5/*
!model/indextts2.5/multilingual_zh_ja_yue_char_del.tiktoken

# OCR scratch: reference tensors/text, transcripts (models live in model/)
data/ocr/

# scratch notebooks / tests, but keep the CMake build inputs + the benchmark
# suite (bench_cpp.cpp is compiled by CMakeLists; bench_py.py is its Python twin)
/bench/*
!/bench/bench_cpp.cpp
!/bench/bench_py.py
tests/*
!tests/test_matmul.cpp

# C# build output
bin/
obj/
