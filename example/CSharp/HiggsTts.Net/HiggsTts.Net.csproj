<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>HiggsTts.Net</AssemblyName>
    <RootNamespace>HiggsTts</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Minitorch.Net\Minitorch.Net.csproj" />
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

  <!-- native core (built by build.py) copied next to the managed output. ggml is
       linked statically into minitorch.dll, so this single file is all we need. -->
  <ItemGroup>
    <None Include="..\..\..\build\minitorch.dll" Link="minitorch.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
